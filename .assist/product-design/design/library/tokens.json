{
  "$description": "Design tokens for exodite-anima. Three tiers: primitive (raw values), semantic (purpose, one value per mode), component (only where a component must diverge). This file is the source of truth; the .pen variables and the docs table are generated from it, and the Flutter theme will be generated or hand-checked against it. Names use category.property.role.variant.",
  "version": "0.2.0",
  "modes": ["light", "dark"],
  "primitive": {
    "color.warm.50": "#FAF7F2",
    "color.warm.100": "#F1ECE3",
    "color.warm.150": "#EDE6DC",
    "color.warm.200": "#DDD4C7",
    "color.warm.400": "#A99F93",
    "color.warm.500": "#8A7F73",
    "color.warm.550": "#7C7267",
    "color.warm.600": "#665D54",
    "color.warm.750": "#3A342E",
    "color.warm.850": "#25211D",
    "color.warm.900": "#2B2622",
    "color.warm.950": "#1B1815",
    "color.sage.200": "#A6C4B3",
    "color.sage.300": "#8FB09E",
    "color.sage.600": "#4F6F5E",
    "color.sage.700": "#3F5A4B",
    "color.sage.950": "#14201A",
    "color.clay.300": "#E5806F",
    "color.clay.600": "#A83A2E",
    "color.amber.300": "#E0B060",
    "color.amber.700": "#8A5A00",
    "color.white": "#FFFFFF",
    "color.black": "#000000"
  },
  "semantic": {
    "color.surface.base":           {"light": "color.warm.50",  "dark": "color.warm.950", "use": "Screen background"},
    "color.surface.raised":         {"light": "color.warm.100", "dark": "color.warm.850", "use": "Cards, inputs, sheets"},
    "color.text.primary":           {"light": "color.warm.900", "dark": "color.warm.150", "use": "Primary text"},
    "color.text.secondary":         {"light": "color.warm.600", "dark": "color.warm.400", "use": "Supporting text, hints, timestamps"},
    "color.border.default":         {"light": "color.warm.200", "dark": "color.warm.750", "use": "Decorative dividers only; never the only cue for a control"},
    "color.border.strong":          {"light": "color.warm.500", "dark": "color.warm.550", "use": "Boundaries of inputs, checkboxes, and cards that must be seen (3:1 or more)"},
    "color.action.primary.bg":      {"light": "color.sage.600", "dark": "color.sage.300", "use": "Primary buttons, links, focus, selected"},
    "color.action.primary.fg":      {"light": "color.white",    "dark": "color.sage.950", "use": "Text and icons on the primary action"},
    "color.action.primary.pressed": {"light": "color.sage.700", "dark": "color.sage.200", "use": "Pressed state of the primary action"},
    "color.focus.ring":             {"light": "color.sage.600", "dark": "color.sage.300", "use": "Keyboard and screen-reader focus, 2 px"},
    "color.status.danger.fg":       {"light": "color.clay.600", "dark": "color.clay.300", "use": "Destructive text and error messages"},
    "color.status.danger.solid":    {"light": "color.clay.600", "dark": "color.clay.300", "use": "Destructive button fill"},
    "color.status.danger.on-solid": {"light": "color.white",    "dark": "color.sage.950", "use": "Text on the destructive button"},
    "color.status.warning.fg":      {"light": "color.amber.700", "dark": "color.amber.300", "use": "Warning label text and border; always paired with words"},
    "color.overlay.scrim":          {"light": "color.black",    "dark": "color.black",    "use": "Dimming behind sheets; used at 50 percent opacity"},
    "color.brand.mark":             {"light": "color.sage.600", "dark": "color.sage.300", "use": "Logo placeholder"}
  },
  "component": {
    "button.height": 52,
    "button.radius": "radius.lg",
    "field.height": 56,
    "field.radius": "radius.md",
    "touch.min": 48
  },
  "scale": {
    "space": {"4": 4, "8": 8, "12": 12, "16": 16, "24": 24, "32": 32, "48": 48, "64": 64},
    "radius": {"sm": 8, "md": 12, "lg": 20, "full": 999},
    "border": {"hairline": 1, "focus": 2},
    "duration": {"instant": 100, "fast": 150, "base": 200, "slow": 300},
    "screen": {"width": 390, "height": 844, "margin": 24}
  },
  "typography": {
    "font.ui": "Inter",
    "font.journal": "Lora",
    "type.display":  {"family": "font.ui",      "size": 28, "line": 36, "weight": 600, "use": "Onboarding headlines"},
    "type.title":    {"family": "font.ui",      "size": 22, "line": 30, "weight": 600, "use": "Screen titles"},
    "type.body":     {"family": "font.ui",      "size": 16, "line": 24, "weight": 400, "use": "Interface text"},
    "type.label":    {"family": "font.ui",      "size": 15, "line": 20, "weight": 600, "use": "Buttons and links"},
    "type.caption":  {"family": "font.ui",      "size": 13, "line": 18, "weight": 400, "use": "Dates and hints"},
    "type.journal":  {"family": "font.journal", "size": 17, "line": 28, "weight": 400, "use": "Entry text in the editor and reading view"}
  }
}
