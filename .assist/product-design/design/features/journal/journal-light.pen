              "type": "text",
              "id": "t231",
              "name": "I want more mornings like th",
              "content": "I want more mornings like this one. Maybe I can leave the phone in my bag and only bring a notebook, but then I would lose the search.",
              "fontFamily": "Lora",
              "fontSize": 17,
              "fontWeight": "400",
              "lineHeight": 1.647,
              "fill": "$color-text-primary",
