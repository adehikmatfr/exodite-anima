        {
          "type": "text",
          "id": "t408",
          "name": "Status: draft, owner product",
          "content": "Status: draft, owner product-design. Design system: tokens 0.2.0. Related: FEAT-003, FEAT-004, ADR-001, THR-001, THR-004, THR-007, THR-011.",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "400",
          "lineHeight": 1.5,
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 900
        },
        {
          "type": "text",
          "id": "t409",
          "name": "Screens: S1 Welcome, S2 Crea",
          "content": "Screens: S1 Welcome, S2 Create passcode, S3 Biometrics, S4 No-recovery warning, S5 Lock, S14 Journal cannot be opened. Every state is drawn; S1 and S5 also at 200 percent text.",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "400",
          "lineHeight": 1.5,
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 900
        },
        {
          "type": "text",
          "id": "t410",
          "name": "Notes: copy is draft and dra",
          "content": "Notes: copy is draft and drawn in English; Indonesian copy is drafted separately and reviewed by the owner (layouts wrap for text about 40 percent longer). Rules shown come from the owner's decisions of 2026-09-20 (lock-and-passcode-policy). Vocabulary follows the glossary (Export, Import) until RS-001 decides.",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "400",
          "lineHeight": 1.5,
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 900
        },
        {
          "type": "text",
          "id": "t411",
          "name": "Restore on a fresh install: ",
          "content": "Restore on a fresh install: passcode setup first, then import (decided 2026-09-20).",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "400",
          "lineHeight": 1.5,
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 900
        },
        {
          "type": "text",
